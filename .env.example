# ──────────────────────────────────────────────────────────────────────
# IMMUTABLE CREDENTIALS — required, gitignored, never committed
# ──────────────────────────────────────────────────────────────────────

# Telegram API secrets (from https://my.telegram.org/apps)
API_ID=
API_HASH=
PHONE=


# ──────────────────────────────────────────────────────────────────────
# OPTIONAL OVERRIDES — uncomment any line to override the committed
# default in config.py. Empty lines / commented lines = use the default.
# See config.py (TUNABLE DEFAULTS section) for the canonical default.
# ──────────────────────────────────────────────────────────────────────

# Audio quality for yt-dlp mp3 extraction (kbps, default 128)
# AUDIO_BITRATE=192

# ID3 album tag applied to every uploaded mp3
# ALBUM_NAME="Лекции Нового Джайпура"

# ID3 genre tag (default "Podcast")
# GENRE="Podcast"

# Bottom line of the Telegram channel caption
# CUSTOM_DESCRIPTION="Лекции @newjaipur"

# Fallback speaker name when --artist is not supplied
# DEFAULT_SPEAKER_NAME="Дас"

# Filesystem overrides (rarely needed; default = <BASE_DIR>/<dir>)
# DOWNLOADS_DIR=downloads
# COVERS_DIR=covers

# Telethon session filename without .session suffix (default "b-shravan-session")
# ENTITY=b-shravan-session

# Telegram channel for uploads — switch between dev/prod here.
# Accepts: @username, -100... canonical id, public id, or invite link.
# CLI flag --channel still overrides this.
# CHANNEL_ID=@hkhrprod

# YouTube channel handle the picker scrapes (default "@SoznanieKrishnyBLR")
# YT_CHANNEL=@SoznanieKrishnyBLR

# How many recent live streams the picker shows (default 5)
# YT_PICKER_LIMIT=5

# Personal Telegram user id for the future "send copy to me" feature
# ADMIN_ID=0